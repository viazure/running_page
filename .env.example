# Personal heart-rate thresholds. Copy this file to .env (gitignored) and fill in your values.
# Do not commit a filled .env, and do not put these numbers in config.yml.
#
# For GitHub Pages, set the same names as repository Variables
# (Settings → Secrets and variables → Actions → Variables), not Secrets.
# Vite only exposes variables prefixed with VITE_ to the frontend bundle.
VITE_LTHR=
VITE_MAX_HR=
